{
  "name": "kaiten-sushi-calc",
  "version": "0.1.0",
  "private": true,
  "description": "Kaiten sushi bill calculator with copy-paste device sync (no server)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start.js",
    "build": "npm test && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:web": "playwright test",
    "test:all": "npm test && npm run typecheck && npm run test:web"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
