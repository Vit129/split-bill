{
  "name": "split-bill",
  "version": "0.1.3",
  "private": true,
  "description": "Bill calculator for Thai restaurants: plates or items, SC and VAT, split per person",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start.js",
    "build": "npm test && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:web": "playwright test",
    "test:all": "npm test && npm run typecheck && npm run test:web",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js patch --dry-run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
